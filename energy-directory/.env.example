# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-07-11

# Email verification (Resend). Leave unset to use the console dev provider.
RESEND_API_KEY=
LEAD_VERIFICATION_FROM_EMAIL=leads@example-directory.au

# SMS verification (Twilio). Leave unset to use the console dev provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# HMAC secret used to sign one-click unsubscribe tokens
UNSUBSCRIBE_TOKEN_SECRET=change-me-in-production
