# Supabase project (see supabase/migrations for the schema to apply)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (admin email notifications — src/lib/email/notify.ts). Optional:
# notifications are silently skipped (logged, not thrown) if unset.
RESEND_API_KEY=
# Defaults to erhan@newpfproperty.com.au in code if unset.
ADMIN_NOTIFICATION_EMAIL=

# Shared secret for POST /api/leads, used by external lead-generation
# sites (e.g. referwise.com.au). Generate with: openssl rand -hex 32
# The calling site must send it as: Authorization: Bearer <secret>
# and must call from ITS SERVER, never from browser JavaScript.
LEAD_CAPTURE_SECRET=

# Anthropic API key for the broker AI Assistant (src/app/api/broker/assistant).
# Get one at https://console.anthropic.com. Optional: the assistant page
# shows a "not configured" message if unset, nothing else breaks.
ANTHROPIC_API_KEY=
